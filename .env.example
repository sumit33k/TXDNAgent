# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-api03-...

# Primary model for orchestration
ORCHESTRATOR_MODEL=claude-opus-4-8
# Model for specialist agents (faster, cheaper)
SPECIALIST_MODEL=claude-sonnet-4-6
# Model for review tasks
REVIEWER_MODEL=claude-sonnet-4-6

# Repository paths (used by repository-context tool)
TXDNA_REPO_PATH=/Users/yourname/transactionDNAPRod
ENTERPRISEOS_REPO_PATH=/Users/yourname/EnterpriseOS

# Agent API server (for admin UI)
AGENT_API_PORT=3721
AGENT_API_HOST=localhost

# Logging
LOG_LEVEL=info
LOG_FILE=logs/agent-framework.log

# Safety gates - set to "true" to require human approval before any file writes
REQUIRE_APPROVAL_FOR_WRITES=true
REQUIRE_APPROVAL_FOR_DESTRUCTIVE=true

# Feature flags
ENABLE_AUDIT_TRAIL=true
ENABLE_RISK_REGISTER=true
MAX_AGENT_TURNS=20
MAX_WORKFLOW_DURATION_MS=300000
