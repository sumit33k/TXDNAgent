# ── LLM Provider ──────────────────────────────────────────────────────────────
# Which backend to use: anthropic | ollama | nvidia
# Default: anthropic
LLM_PROVIDER=anthropic

# ── Anthropic Claude API ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# Primary model for orchestration (Anthropic)
ORCHESTRATOR_MODEL=claude-opus-4-8
# Model for specialist agents — faster, cheaper (Anthropic)
SPECIALIST_MODEL=claude-sonnet-4-6
# Model for review tasks (Anthropic)
REVIEWER_MODEL=claude-sonnet-4-6

# ── Ollama (local LLM) ─────────────────────────────────────────────────────────
# Ollama server base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for all agents (can override per-role below)
OLLAMA_MODEL=glm4:latest

# Per-role model overrides (fall back to OLLAMA_MODEL if unset)
OLLAMA_ORCHESTRATOR_MODEL=glm4:latest
OLLAMA_SPECIALIST_MODEL=glm4:latest
OLLAMA_REVIEWER_MODEL=glm4:latest

# Set to "false" to disable tool/function calling (injects repo context into prompt instead)
OLLAMA_TOOL_USE=true

# ── NVIDIA NIM ─────────────────────────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

NVIDIA_ORCHESTRATOR_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_SPECIALIST_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_REVIEWER_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ── Repository paths (used by repository-context tool) ────────────────────────
TXDNA_REPO_PATH=/Users/yourname/transactionDNAPRod
ENTERPRISEOS_REPO_PATH=/Users/yourname/EnterpriseOS

# ── Agent API server (for admin UI) ───────────────────────────────────────────
AGENT_API_PORT=3721
AGENT_API_HOST=localhost

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=logs/agent-framework.log

# ── Safety gates ──────────────────────────────────────────────────────────────
REQUIRE_APPROVAL_FOR_WRITES=true
REQUIRE_APPROVAL_FOR_DESTRUCTIVE=true

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_AUDIT_TRAIL=true
ENABLE_RISK_REGISTER=true
MAX_AGENT_TURNS=20
MAX_WORKFLOW_DURATION_MS=300000
